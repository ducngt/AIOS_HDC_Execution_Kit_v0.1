@@ -0,0 +1,98 @@
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+
+SOURCE = Path(__file__).resolve().parents[1]
+
+
+def run(*args, cwd=None, env=None):
+    return subprocess.run(args, cwd=cwd, env=env, text=True, capture_output=True)
+
+
+class T00Tests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name) / "repo"
+        self.root.mkdir()
+        for directory in ("hdc", "tasks", "change-packages"):
+            shutil.copytree(SOURCE / directory, self.root / directory,
+                            ignore=shutil.ignore_patterns("state.json", "__pycache__", "*.pyc"))
+        for args in (("init", "-q"), ("config", "user.name", "Example"),
+                     ("config", "user.email", "example@example.invalid")):
+            self.assertEqual(run("git", *args, cwd=self.root).returncode, 0)
+        (self.root / "baseline.txt").write_text("baseline\n")
+        self.commit("baseline")
+        self.base = run("git", "rev-parse", "HEAD", cwd=self.root).stdout.strip()
+
+    def commit(self, message):
+        self.assertEqual(run("git", "add", ".", cwd=self.root).returncode, 0)
+        self.assertEqual(run("git", "commit", "-qm", message, cwd=self.root).returncode, 0)
+
+    def guard(self, base):
+        env = os.environ.copy()
+        env["HDC_BASE_REF"] = base
+        return run("python", "hdc/guard.py", cwd=self.root, env=env)
+
+    def test_guard_fails_closed_when_base_is_missing(self):
+        env = os.environ.copy()
+        env.pop("HDC_BASE_REF", None)
+        result = run("python", "hdc/guard.py", cwd=self.root, env=env)
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("HDC_BASE_REF is required", result.stderr + result.stdout)
+
+    def test_initial_push_uses_empty_tree(self):
+        result = self.guard("0" * 40)
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+
+    def test_guard_checks_change_package_from_earlier_commit(self):
+        package = self.root / "change-packages" / "CP-T00.json"
+        package.write_text("{}\n")
+        self.commit("invalid package in first PR commit")
+        (self.root / "feature.py").write_text("value = 1\n")
+        self.commit("implementation in second PR commit")
+        result = self.guard(self.base)
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("Invalid change package", result.stdout)
+        self.assertEqual(self.guard("HEAD~1").returncode, 1)  # Also missing package in last commit.
+
+    def test_accept_cannot_write_state(self):
+        before = self.root / "hdc" / "state.json"
+        result = run("python", "hdc/hdc.py", "accept", "T00", cwd=self.root)
+        self.assertNotEqual(result.returncode, 0)
+        self.assertFalse(before.exists())
+
+    def test_complete_rejects_missing_or_failed_evidence(self):
+        evidence = self.root / "evidence.json"
+        evidence.write_text(json.dumps({"task_id": "T00", "outputs": {}, "checks": {}}))
+        result = run("python", "hdc/hdc.py", "complete", "T00", "evidence.json", cwd=self.root)
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("missing required output", result.stderr + result.stdout)
+        self.assertFalse((self.root / "hdc" / "state.json").exists())
+
+    def test_complete_checks_reported_results_and_keeps_acceptance_separate(self):
+        manifest = json.loads((self.root / "tasks" / "T00" / "task.json").read_text())
+        artifact = self.root / "artifact.txt"
+        artifact.write_text("review this artifact\n")
+        evidence = self.root / "evidence.json"
+        report = {"task_id": "T00", "outputs": {name: "artifact.txt" for name in manifest["required_outputs"]},
+                  "checks": {"build": "passed", "tests": "failed", "architecture_guard": "passed"}}
+        evidence.write_text(json.dumps(report))
+        failed = run("python", "hdc/hdc.py", "complete", "T00", "evidence.json", cwd=self.root)
+        self.assertNotEqual(failed.returncode, 0)
+        report["checks"]["tests"] = "passed"
+        evidence.write_text(json.dumps(report))
+        completed = run("python", "hdc/hdc.py", "complete", "T00", "evidence.json", cwd=self.root)
+        self.assertEqual(completed.returncode, 0, completed.stderr)
+        state = json.loads((self.root / "hdc" / "state.json").read_text())
+        self.assertEqual(state["completed"], ["T00"])
+        self.assertEqual(state["accepted"], [])
+
+
+if __name__ == "__main__":
+    unittest.main()
